[Unit]
Description=amper - sterge parola aplicatiei daca pe card e fisierul resetare-parola.txt
After=local-fs.target
RequiresMountsFor=/boot/firmware
Before=amper.service

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/amper
ExecStart=/usr/bin/python3 -m amper.password_reset -c /etc/amper/config.yaml
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
